{
  "apiVersion": "v1",
  "kind": "List",
  "items": [
    {
      "apiVersion": "v1",
      "kind": "ServiceAccount",
      "metadata": {
        "name": "wallettracker-repository",
        "namespace": "argocd"
      },
      "automountServiceAccountToken": false
    },
    {
      "apiVersion": "secrets.hashicorp.com/v1beta1",
      "kind": "VaultAuth",
      "metadata": {
        "name": "wallettracker-repository",
        "namespace": "argocd"
      },
      "spec": {
        "vaultConnectionRef": "vault-secrets-operator/default",
        "method": "jwt",
        "mount": "jwt",
        "jwt": {
          "role": "wallettracker-repository",
          "serviceAccount": "wallettracker-repository",
          "audiences": [
            "vault-vso"
          ],
          "tokenExpirationSeconds": 600
        }
      }
    },
    {
      "apiVersion": "rbac.authorization.k8s.io/v1",
      "kind": "Role",
      "metadata": {
        "name": "wallettracker-repo-token-request",
        "namespace": "argocd"
      },
      "rules": [
        {
          "apiGroups": [
            ""
          ],
          "resources": [
            "serviceaccounts/token"
          ],
          "resourceNames": [
            "wallettracker-repository"
          ],
          "verbs": [
            "create"
          ]
        }
      ]
    },
    {
      "apiVersion": "rbac.authorization.k8s.io/v1",
      "kind": "RoleBinding",
      "metadata": {
        "name": "wallettracker-repo-token-request",
        "namespace": "argocd"
      },
      "roleRef": {
        "apiGroup": "rbac.authorization.k8s.io",
        "kind": "Role",
        "name": "wallettracker-repo-token-request"
      },
      "subjects": [
        {
          "kind": "ServiceAccount",
          "name": "vault-secrets-operator-controller-manager",
          "namespace": "vault-secrets-operator"
        }
      ]
    },
    {
      "apiVersion": "secrets.hashicorp.com/v1beta1",
      "kind": "VaultStaticSecret",
      "metadata": {
        "name": "wallettracker-repository",
        "namespace": "argocd"
      },
      "spec": {
        "vaultAuthRef": "wallettracker-repository",
        "mount": "wallettracker",
        "path": "delivery/gitops-read",
        "type": "kv-v2",
        "refreshAfter": "60s",
        "hmacSecretData": true,
        "destination": {
          "name": "wallettracker-repository",
          "create": true,
          "type": "Opaque",
          "transformation": {
            "excludeRaw": true,
            "excludes": [
              ".*"
            ],
            "templates": {
              "type": {
                "text": "git"
              },
              "url": {
                "text": "ssh://git@10.2.0.11:2222/downops/wallet-tracker-backend.git"
              },
              "sshPrivateKey": {
                "text": "{{ .Secrets.SSH_PRIVATE_KEY | trim | printf \"%s\\n\" }}"
              },
              "insecureIgnoreHostKey": {
                "text": "false"
              }
            }
          },
          "labels": {
            "argocd.argoproj.io/secret-type": "repository"
          },
          "annotations": {
            "argocd.argoproj.io/secret-type": "repository"
          }
        }
      }
    }
  ]
}
