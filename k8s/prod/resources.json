          }
        },
        "template": {
          "metadata": {
            "labels": {
              "app": "wallettracker-api",
              "wallettracker.io/database-client": "true"
            }
          },
          "spec": {
            "serviceAccountName": "wallettracker",
            "automountServiceAccountToken": false,
            "imagePullSecrets": [
              {
                "name": "harbor-pull-downops"
              }
            ],
            "securityContext": {
              "fsGroup": 10001,
              "seccompProfile": {
                "type": "RuntimeDefault"
              }
            },
            "terminationGracePeriodSeconds": 45,
            "containers": [
              {
                "name": "api",
                "image": "registry.int.downops.win/downops/wallettracker/backend:prepared-not-deployed",
                "ports": [
                  {
                    "containerPort": 5000,
                    "name": "http"
                  }
                ],
                "envFrom": [
                  {
                    "configMapRef": {
                      "name": "wallettracker-config"
                    }
                  },
                  {
                    "secretRef": {
                      "name": "wallettracker-signing"
                    }
                  }
                ],
                "env": [
                  {
                    "name": "DATABASE_ROOT_PASSWORD",
                    "valueFrom": {
                      "secretKeyRef": {
                        "name": "wallettracker-db",
                        "key": "MARIADB_ROOT_PASSWORD"
                      }
                    }
                  }
                ],
                "resources": {
                  "requests": {
                    "cpu": "50m",
                    "memory": "96Mi"
                  },
                  "limits": {
                    "cpu": "500m",
                    "memory": "256Mi"
                  }
                },
                "securityContext": {
                  "runAsNonRoot": true,
                  "runAsUser": 10001,
                  "runAsGroup": 10001,
                  "readOnlyRootFilesystem": true,
                  "allowPrivilegeEscalation": false,
                  "capabilities": {
                    "drop": [
                      "ALL"
                    ]
                  }
                },
                "volumeMounts": [
                  {
                    "name": "rsa",
                    "mountPath": "/run/wallettracker-rsa",
                    "readOnly": true
                  },
                  {
                    "name": "tmp",
                    "mountPath": "/tmp"
                  }
                ],
                "startupProbe": {
                  "httpGet": {
                    "path": "/api/v1/health",
                    "port": 5000
                  },
                  "failureThreshold": 30,
                  "periodSeconds": 5
                },
                "livenessProbe": {
                  "httpGet": {
                    "path": "/api/v1/health",
                    "port": 5000
                  },
                  "periodSeconds": 15
                },
                "readinessProbe": {
                  "httpGet": {
                    "path": "/api/v1/ready",
                    "port": 5000
                  },
                  "periodSeconds": 5
                }
              }
            ],
            "volumes": [
              {
                "name": "rsa",
                "secret": {
                  "secretName": "wallettracker-rsa",
                  "defaultMode": 288
                }
              },
              {
                "name": "tmp",
                "emptyDir": {
                  "medium": "Memory",
                  "sizeLimit": "32Mi"
                }
              }
            ]
          }
        }
      }
    },
    {
      "apiVersion": "v1",
      "kind": "Service",
      "metadata": {
        "name": "wallettracker-api",
        "namespace": "wallettracker-prod",
        "annotations": {
          "argocd.argoproj.io/sync-wave": "-20"
        }
      },
      "spec": {
        "type": "NodePort",
        "externalTrafficPolicy": "Local",
        "selector": {
          "app": "wallettracker-api"
        },
        "ports": [
          {
            "port": 5000,
            "targetPort": 5000,
            "nodePort": 31411
          }
        ]
      }
    },
    {
      "apiVersion": "v1",
      "kind": "ConfigMap",
      "metadata": {
        "name": "wallettracker-migration",
        "namespace": "wallettracker-prod",
        "annotations": {
          "argocd.argoproj.io/sync-wave": "-20"
        }
      },
      "data": {
        "require_restore.py": "\"\"\"Require the reviewed production upgrade policy before applying schema changes.\"\"\"\nimport os,sys,time\nsys.path.insert(0,'/app')\n# Newly created Pods can briefly precede NetworkPolicy/dataplane convergence.\n# Wait for authenticated SQL, never treat a transport failure as restore proof.\nfrom sqlalchemy import create_engine,text\nfrom sqlalchemy.exc import OperationalError\nfrom migrate_all import database_url\nsys.path.insert(0,'/migration')\nprobe=create_engine(database_url('mysql'),connect_args={'connect_timeout':5})\ntry:\n    for attempt in range(30):\n        try:\n            with probe.connect() as connection:connection.execute(text('SELECT 1'))\n            break\n        except OperationalError:\n            if attempt==29:raise SystemExit('Database connectivity did not converge; migration refused') from None\n            time.sleep(2)\nfinally:probe.dispose()\nif os.environ.get('WALLET_TRACKER_REQUIRE_RESTORE_CHECKPOINT','false').lower()=='true':\n    from sqlalchemy import text\n    from migrate_all import database_url\n    from sqlalchemy import create_engine\n    engine=create_engine(database_url('wallettracker_migration_metadata'))\n    try:\n        with engine.connect() as connection:\n            if connection.execute(text('SELECT COUNT(*) FROM restore_checkpoint WHERE id=1')).scalar()!=1:\n                raise RuntimeError()\n    except Exception:\n        raise SystemExit('Approved production restore checkpoint absent; migration refused') from None\n    finally:engine.dispose()\nif os.environ.get('WALLET_TRACKER_REQUIRED_UPGRADE_CHECKPOINT'):\n    from upgrade_checkpoint import require_upgrade_checkpoint\n    from migrate_all import get_engine,get_tenant_databases,DATABASE_NAME\n    try:\n        require_upgrade_checkpoint(get_engine,DATABASE_NAME,get_tenant_databases)\n    except Exception:\n        raise SystemExit('Reviewed schema-only approval or legacy recovery checkpoint required before API-v2 production migration') from None\nfrom migrate_all import main\nmain()\n",
        "upgrade_checkpoint.py": "\"\"\"Fresh release-specific restore proof for the first production API-v2 upgrade.\"\"\"\nimport os\nimport json\nimport pathlib\nimport re\n\nAPI_V2 = 'wallettracker-api-v2'\nMAIN_HEAD = 'd2a100000001'\nTENANT_HEAD = 'd2b100000001'\n# The reviewed server-properties migration is a direct additive successor of\n# the already-approved API-v2 baseline. Unknown/future heads stay fail-closed.\nUPGRADED_MAIN_HEADS = frozenset({MAIN_HEAD, 'd2c100000001'})\n\n\ndef require_schema_only_approval(path, database_name):\n    \"\"\"Reviewed GitOps approval, not a fabricated backup/restore checkpoint.\"\"\"\n    approval = json.loads(pathlib.Path(path).read_text())\n    expected = {\n        'approval_id': 'wallettracker-api-v2-schema-only',\n        'approved_by': 'owner', 'schema_upgrade_authorized': True,\n        'database_name': database_name, 'namespace': 'wallettracker-prod',\n        'target_main_head': MAIN_HEAD, 'target_tenant_head': TENANT_HEAD,\n        'backup_requested': False, 'restore_requested': False, 'data_reset': False,\n    }\n    revision = approval.get('source_revision', '')\n    if (not re.fullmatch('[a-f0-9]{40}', revision)\n            or revision != os.environ.get('APP_BUILD_REVISION')\n            or os.environ.get('POD_NAMESPACE') != 'wallettracker-prod'\n            or database_name != 'wallet_tracker'\n            or any(type(approval.get(k)) is not type(v) or approval.get(k) != v\n                   for k, v in expected.items())\n            or set(approval) != set(expected) | {'source_revision'}):\n        raise RuntimeError('Reviewed schema-only release approval does not match this image/database')\n\n\ndef statement(sql):\n    from sqlalchemy import text\n    return text(sql)\n\n\ndef version(engine):\n    with engine.connect() as connection:\n        return connection.execute(statement('SELECT version_num FROM alembic_version')).scalar_one()\n\n\ndef already_upgraded(get_engine, database_name, get_tenants):\n    main = get_engine(database_name)\n    try:\n        if version(main) not in UPGRADED_MAIN_HEADS:\n            return False\n        for name in get_tenants(main):\n            tenant = get_engine(name)\n            try:\n                if version(tenant) != TENANT_HEAD:\n                    return False\n            finally:\n                tenant.dispose()\n        return True\n    finally:\n        main.dispose()\n\n\ndef require_upgrade_checkpoint(get_engine, database_name, get_tenants):\n    target = os.environ.get('WALLET_TRACKER_REQUIRED_UPGRADE_CHECKPOINT')\n    if not target:\n        return\n    if target != API_V2:\n        raise RuntimeError('Unknown production upgrade checkpoint')\n    if already_upgraded(get_engine, database_name, get_tenants):\n        return\n    approval = os.environ.get('WALLET_TRACKER_SCHEMA_UPGRADE_APPROVAL_FILE')\n    if approval:\n        require_schema_only_approval(approval, database_name)\n        return\n    metadata = get_engine('wallettracker_migration_metadata')\n    try:\n        with metadata.connect() as connection:\n            approved = connection.execute(statement(\n                'SELECT COUNT(*) FROM release_checkpoint WHERE name=:name '\n                'AND restore_verified=1 AND write_freeze_verified=1 '\n                'AND backup_created_at >= CURRENT_TIMESTAMP - INTERVAL 24 HOUR '\n                'AND approved_at >= backup_created_at'), {'name': target}).scalar_one()\n            if approved != 1:\n                raise RuntimeError('Fresh production release recovery proof is absent')\n    finally:\n        metadata.dispose()\n",
        "schema-upgrade-approval.json": "{\"approval_id\": \"wallettracker-api-v2-schema-only\", \"approved_by\": \"owner\", \"backup_requested\": false, \"data_reset\": false, \"database_name\": \"wallet_tracker\", \"namespace\": \"wallettracker-prod\", \"restore_requested\": false, \"schema_upgrade_authorized\": true, \"source_revision\": \"3cb6370ec414ed7c87920ba0cfe134994934c474\", \"target_main_head\": \"d2a100000001\", \"target_tenant_head\": \"d2b100000001\"}"
      }
