      "spec": {
        "vaultConnectionRef": "vault-secrets-operator/default",
        "method": "jwt",
        "mount": "jwt",
        "jwt": {
          "role": "wallettracker-dev-pull",
          "serviceAccount": "pull",
          "audiences": [
