#!/sbin/openrc-run
# Preparation asset only. Installing this file does not authorize a service start.
description="Official Vault Agent supervising native-cloudflared-wallettracker"
supervisor=supervise-daemon
command=/opt/hashicorp/vault/2.1.2/vault
command_args="agent -config=/etc/vault-agent/native-cloudflared-wallettracker/config/agent.hcl"
command_user=root:root
pidfile=/run/native-cloudflared-wallettracker.pid
respawn_delay=5
respawn_max=0
output_log="/var/log/cloudflared.log"
error_log="/var/log/cloudflared.log"
# KEEP STOPPED until preflight/cutover callback: legacy tunnel was crashed.
# Owner now authorizes restoration of this SAME static-token connector after
# role/binary/TLS preflight. Create allow-start only during that approved cutover.
depend() { need net; after wallettracker; }
start_pre() {
  # Deliberately absent until the now-authorized staged restoration cutover.
  if [ ! -f /etc/vault-agent/native-cloudflared-wallettracker/allow-start ]; then
    eerror "Wallet tunnel awaits successful preflight and the cutover allow-start marker"
    return 1
  fi
  ulimit -c 0
  umask 077
  # Never inherit a shell/operator token over the configured scoped AppRole.
  for vault_env_key in $(env | cut -d= -f1); do
    case "$vault_env_key" in VAULT_*) unset "$vault_env_key" ;; esac
  done
  /bin/mkdir -p /run/vault-agent-native-cloudflared-wallettracker
  /bin/chmod 0700 /run/vault-agent-native-cloudflared-wallettracker
}
